# Local-dev defaults for Sanity Studio. COMMITTED and loaded automatically by
# `sanity dev` (development mode). Non-sensitive values only. `sanity build` /
# `sanity deploy` run in production mode and do NOT read this file — the
# deployed Studio gets its values from deploy-studio.yml.
#
# The Studio is OPTIONAL for local dev: `pnpm dev` runs the site on local
# sample content with no Sanity project. Sanity is a hosted content lake, so
# the Studio needs a real project — create a free personal one at
# https://www.sanity.io/manage and put its ID in a gitignored
# studio/.env.development.local (loaded after this, so it wins):
#   SANITY_STUDIO_PROJECT_ID=<your project id>
# See docs/run-locally.md § Sanity Studio (optional).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Backend base URL the Studio's custom order PII panels call.
SANITY_STUDIO_API_URL=http://localhost:3001

# Bearer token for the backend's /admin/* routes. Must match ADMIN_API_TOKEN
# in backend/.env.development. Obviously-dev value; the production token is
# injected by deploy-studio.yml.
SANITY_STUDIO_ADMIN_TOKEN=local-dev-admin-token
