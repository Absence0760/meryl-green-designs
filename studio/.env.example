# Sanity project details — create a project at https://www.sanity.io/manage
# and copy the project ID and dataset name here.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Backend base URL the Studio's custom PII panels call. Local dev points
# at the backend dev server; the production studio is configured at
# `sanity deploy` time to point at https://merylgreendesigns.com/api.
SANITY_STUDIO_API_URL=http://localhost:3001

# Bearer token for /admin/* on the backend. Must match the backend's
# ADMIN_API_TOKEN. This value is baked into the Studio JS bundle at
# build time and therefore readable by anyone who inspects the bundle —
# the backend bearer-token check is the actual security gate.
# See docs/orders-pii-split-plan.md § Admin auth.
SANITY_STUDIO_ADMIN_TOKEN=
