# Local-dev defaults for the backend. COMMITTED and loaded automatically by
# `pnpm dev` / `pnpm backend dev` (src/server.ts) — a fresh clone runs fully
# offline with no setup. Non-sensitive values only (localhost URLs, ports,
# dev-only flags, PayFast's PUBLIC sandbox merchant). Real production secrets
# live in the private infra-secrets repo (never here) and reach the Lambda via
# Terraform; machine-local real values go in a gitignored
# backend/.env.development.local (loaded first, so it wins, key by key).
#
# The deployed Lambda never reads this file: lambda.ts doesn't load dotenv,
# and createApp() refuses to start on Lambda with the dev-only values below
# (src/runtime-guard.ts).
#
# Reference for every variable: docs/deployment.md § Environment variable
# reference. Local walkthrough: docs/run-locally.md.

# --- Content + orders -------------------------------------------------------
# `local` reads products / gallery / testimonials from
# backend/.dev-content/content.json (gitignored — your own), falling back to
# the committed generic sample in backend/dev-content.sample/. It also stores
# the order skeleton in backend/.dev-content/orders.json instead of Sanity.
# Set CONTENT_BACKEND=sanity in .env.development.local to use a real Sanity
# project (then fill in the SANITY_* values there too).
CONTENT_BACKEND=local
# CONTENT_DEV_DIR=.dev-content

# Sanity — only read when CONTENT_BACKEND=sanity. Project ID from
# https://www.sanity.io/manage; the API token (Editor role) is a SECRET, so
# it goes in .env.development.local, never here.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
# Shared secret for verifying Sanity webhook signatures (secret — local file
# only). Unused in local mode: local orders have no webhook.
SANITY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# `file` writes every email to backend/.dev-emails/ (gitignored) and logs a
# file:// link — no Resend account needed. Open the newest with
# `pnpm dev:emails`. To send for real, set EMAIL_BACKEND=resend and
# RESEND_API_KEY (secret) in .env.development.local.
EMAIL_BACKEND=file
RESEND_API_KEY=
FROM_EMAIL="Meryl Green Designs <orders@example.com>"
OWNER_EMAIL=owner@example.com

# --- URLs / CORS ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:7777
SITE_URL=http://localhost:7777
# Base URL for PayFast's ITN notify_url. Override with an ngrok URL in
# .env.development.local when testing ITN callbacks (docs/run-locally.md).
API_URL=http://localhost:3001
PORT=3001

# --- PayFast ----------------------------------------------------------------
# PayFast's PUBLIC sandbox merchant (published at
# https://developers.payfast.co.za/docs#sandbox). Moves no real money.
PAYFAST_MERCHANT_ID=10004002
PAYFAST_MERCHANT_KEY=q1cd2rdny4a53
PAYFAST_PASSPHRASE=payfast
PAYFAST_SANDBOX=true

# --- Order PII (DynamoDB via LocalStack) ------------------------------------
# Start LocalStack with `pnpm dev:db:up` (docker) to place orders locally.
# Leaving DYNAMODB_ENDPOINT set keeps the SDK off real AWS (src/dynamo.ts).
ORDERS_TABLE_NAME=meryl-green-designs-orders
DYNAMODB_ENDPOINT=http://localhost:4566

# --- Studio admin routes ----------------------------------------------------
# Bearer token for /admin/* (the Studio's order PII panels). Obviously-dev
# value, matched in studio/.env.development. The backend refuses to start on
# Lambda with this value.
ADMIN_API_TOKEN=local-dev-admin-token
STUDIO_ORIGINS=http://localhost:3333
