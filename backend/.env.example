# Email backend. Default `resend` sends real emails via the Resend HTTP
# API. Set to `file` for fully-local dev capture — emails get written to
# backend/.dev-emails/<timestamp>-<subject>.html (gitignored) with the
# file:// URL logged to stdout. No external traffic, no cost.
# Leave UNSET in production.
EMAIL_BACKEND=file

# Resend API key — get one from https://resend.com/api-keys.
# Required only when EMAIL_BACKEND=resend.
RESEND_API_KEY=

# The "from" address used on outgoing emails.
# Must be a verified sender/domain in your Resend account.
FROM_EMAIL="Meryl Green Designs <orders@example.com>"

# The address that receives new order notifications.
OWNER_EMAIL=meryl@example.com

# Comma-separated list of origins allowed to call this API.
# In prod, set this to your CloudFront domain (e.g. https://merylgreendesigns.com).
ALLOWED_ORIGINS=http://localhost:7777

# Public URL of the site — used to build tracking links in confirmation emails.
SITE_URL=http://localhost:7777

# Sanity — server-side credentials for reading and writing order documents.
# Get the project ID from https://www.sanity.io/manage.
# Create the API token under the project's API → Tokens tab with Editor role
# (or a custom role scoped to the `order` type if you want tighter permissions).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Shared secret for verifying Sanity webhook signatures. Generate a random
# string (e.g. `openssl rand -hex 32`) and paste the same value into Sanity's
# webhook configuration.
SANITY_WEBHOOK_SECRET=

# PayFast payment gateway credentials.
# Register at https://payfast.co.za — no monthly fee, pay-per-transaction only.
# For sandbox testing, use: Merchant ID 10004002, Merchant Key q1cd2rdny4a53,
# Passphrase payfast, and set PAYFAST_SANDBOX=true.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Optional. Overrides the backend's own base URL when building the PayFast
# ITN notify_url. In production this is auto-derived from the incoming
# request, so the Lambda leaves it unset. Set it locally to an ngrok tunnel
# URL when testing PayFast ITN callbacks, since PayFast can't reach
# localhost. See docs/run-locally.md § Testing PayFast with sandbox credentials.
API_URL=http://localhost:3001

# Port for local dev server.
PORT=3001

# DynamoDB table holding customer order PII (Phase 0 dual-write target).
# Set by Terraform on the deployed Lambda; for local dev runs against the
# docker-compose dynamodb-local container (bring up with
# `bin/dynamodb-local-up.sh`).
ORDERS_TABLE_NAME=meryl-green-designs-orders

# Local DynamoDB endpoint (LocalStack edge gateway). Leave UNSET in
# production so the SDK uses the AWS-hosted service via the Lambda
# role. Set for local dev so the same code path reaches the
# docker-compose LocalStack container without touching prod.
DYNAMODB_ENDPOINT=http://localhost:4566

# Bearer token guarding the /admin/* routes that power the Sanity Studio
# custom panels for order PII. Generate with `openssl rand -hex 32`.
# Production: same value lives encrypted in the sibling private repo at
# ../infra-secrets/meryl-green-designs/terraform.tfvars.sops and gets pushed to
# the Lambda env by terraform apply.
ADMIN_API_TOKEN=

# Comma-separated origins allowed to call /admin/*. Tighter than
# ALLOWED_ORIGINS — only the Sanity Studio bundle should hit admin
# routes. Local dev defaults to http://localhost:3333.
STUDIO_ORIGINS=http://localhost:3333
