# Resend API key — get one from https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address used on outgoing emails.
# Must be a verified sender/domain in your Resend account.
FROM_EMAIL="Meryl Green Designs <orders@example.com>"

# The address that receives new order notifications.
OWNER_EMAIL=meryl@example.com

# Comma-separated list of origins allowed to call this API.
# In prod, set this to your CloudFront domain (e.g. https://merylgreendesigns.co.za).
ALLOWED_ORIGINS=http://localhost:7777

# Port for local dev server.
PORT=3001
