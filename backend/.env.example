# Resend API key — get one from https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address used on outgoing emails.
# Must be a verified sender/domain in your Resend account.
FROM_EMAIL="Meryl Green Designs <orders@example.com>"

# The address that receives new order notifications.
OWNER_EMAIL=meryl@example.com

# Comma-separated list of origins allowed to call this API.
# In prod, set this to your CloudFront domain (e.g. https://merylgreendesigns.co.za).
ALLOWED_ORIGINS=http://localhost:7777

# Public URL of the site — used to build tracking links in confirmation emails.
SITE_URL=http://localhost:7777

# Sanity — server-side credentials for reading and writing order documents.
# Get the project ID from https://www.sanity.io/manage.
# Create the API token under the project's API → Tokens tab with Editor role
# (or a custom role scoped to the `order` type if you want tighter permissions).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Shared secret for verifying Sanity webhook signatures. Generate a random
# string (e.g. `openssl rand -hex 32`) and paste the same value into Sanity's
# webhook configuration.
SANITY_WEBHOOK_SECRET=

# Banking details injected into the pending-payment email at send time. These
# are deliberately NOT hardcoded in the email template or shown on the public
# shop page — bank details only leave the server in the confirmation email to
# a customer who provided a valid email address. If any of the four is left
# blank, the email falls back to a "reply to this email for our banking
# details" message instead of a broken card.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=

# Port for local dev server.
PORT=3001
