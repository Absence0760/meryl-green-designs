# Local-dev defaults for the frontend. COMMITTED and loaded automatically by
# Vite/SvelteKit in development mode (`pnpm dev`, `pnpm check`) — a fresh
# clone runs with no setup. Non-sensitive values only: every PUBLIC_* var is
# inlined into the browser bundle anyway. Machine-local overrides go in a
# gitignored frontend/.env.development.local (loaded after this, so it wins).
#
# `vite build` (production mode) does NOT read this file: production builds
# get PUBLIC_* from the deploy workflow's environment (deploy-frontend.yml),
# and vite.config.ts fails a production build that has none.

# URL of the backend API (must be reachable from the browser).
PUBLIC_API_URL=http://localhost:3001

# Public URL of the site itself (absolute Open Graph URLs).
PUBLIC_SITE_URL=http://localhost:7777

# Sanity project used only to build image URLs on Sanity's public CDN.
# Blank is fine for local dev: the backend's local content mode serves
# `local:` photos itself. Set it in .env.development.local if you point the
# backend at a real Sanity project (CONTENT_BACKEND=sanity).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
