# URL of the backend API (must be reachable from the browser).
# In local development this is the Hono dev server.
PUBLIC_API_URL=http://localhost:3001

# Public URL of the site itself. Baked into the frontend at build time so
# Open Graph tags (og:url, og:image) can be absolute, which is what social
# crawlers like Facebook, WhatsApp and Twitter expect.
PUBLIC_SITE_URL=http://localhost:7777

# Sanity project used to fetch content at build time.
# Create a project at https://www.sanity.io/manage and copy the IDs here.
# The shop page will render with an empty product list if these are unset.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
