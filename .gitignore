# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
.svelte-kit/
build/
dist/
frontend/build/
frontend/.svelte-kit/
backend/dist/
studio/dist/

# Sanity CLI local state (auth cache, deploy cache)
.sanity/

# Vite cache (outside node_modules)
.vite/

# TypeScript incremental build info
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
# Plaintext env files are always secret and never committed. The ENCRYPTED
# secrets (*.sops) no longer live in this repo: they were relocated to the
# sibling PRIVATE repo Absence0760/infra-secrets (under meryl-green-designs/) on
# 2026-06-24, because this repo is public. Keep it that way — the rules below
# also block any *.sops blob from being re-committed here by accident.
#
# See docs/deployment.md § Secrets management for the workflow.
.env
.env.*
.envrc
!.env.example

# Never re-introduce encrypted secret blobs into this public repo.
*.sops

# Terraform variable files. The plaintext terraform.tfvars is a transient
# decrypted scratch file (shredded by bin/setup.sh); only the example is
# committed.
*.tfvars
!*.tfvars.example

# ---------------------------------------------------------------------------
# Local email capture (backend/src/email.ts file backend, dev-only)
# ---------------------------------------------------------------------------
.dev-emails/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Test artifacts (future-proofing — no tests yet)
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
.playwright/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------------------------------------------------------------------------
# Local agent / AI tooling state
# ---------------------------------------------------------------------------
# Most .claude/ contents are per-developer state (caches, transcripts, local
# permission overrides) and stay out of git. Committed exceptions:
#   - settings.json — project-wide deny-list of destructive commands
#     (see docs/security.md § Risk 8)
#   - agents/, commands/ — slash-command + subagent definitions shared
#     with the team (see .claude/commands/audit/README.md)
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
